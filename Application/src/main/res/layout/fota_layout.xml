<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section -->

        <!-- MAC Address Section -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="127dp"
            android:background="@drawable/fota_header_bg"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:gravity="right"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="20dp"
                    android:background="@drawable/clogo"
                    app:tint="#4FC3F7" />
            </LinearLayout>

            <ImageView
                android:id="@+id/fota_logo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/fota_logo_bg"
                android:padding="10dp"
                android:src="@drawable/system_update_alt_24px"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="15dp"
                android:layout_toEndOf="@id/fota_logo"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FOTA Manager"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Firmware Over The Air"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/connection_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/fota_status_bg"
                android:drawableStart="@android:drawable/presence_busy"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Disconnected"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                app:drawableTint="#FFCC00" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="-38dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/fota_mac_bg"
            android:gravity="center_vertical"
            android:padding="5dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="#B3FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="MAC ADDRESS"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/device_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/default_mac"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Step Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/fota_card_bg"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEP STATUS"
                android:textColor="#9EABB8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Consent -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/cons_circle_state"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/circle_state_red_bg">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/check"
                            app:tint="@android:color/white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="CONSENT"
                        android:textColor="#D32F2F"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Integrity -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/integrity_circle"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/circle_state_red_bg">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/check"
                            app:tint="@android:color/white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="INTEGRITY"
                        android:textColor="#D32F2F"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Installed -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/installation_circle"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/circle_state_red_bg">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/check"
                            app:tint="@android:color/white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="INSTALLED"
                        android:textColor="#D32F2F"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Firmware Source Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/fota_card_bg"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIRMWARE SOURCE"
                android:textColor="#9EABB8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Firmware File"
                android:textColor="#546E7A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/ET_filePath"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/fota_input_bg"
                    android:editable="false"
                    android:focusable="false"
                    android:hint="No file selected..."
                    android:paddingHorizontal="16dp"
                    android:textColorHint="#BDC3C7"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/browes_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/fota_button_secondary_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:onClick="BrowesFile"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_save"
                        app:tint="#546E7A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Browse"
                        android:textColor="#546E7A"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="OTA Channel"
                android:textColor="#546E7A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Spinner with dropdown arrow -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="5dp">

                <Spinner
                    android:id="@+id/spinner_version"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/fota_input_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="36dp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="10dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:src="@drawable/arrow_drop_down_24px"
                    app:tint="#546E7A" />
            </RelativeLayout>

            <Button
                android:id="@+id/btn_consent"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/fota_button_primary"
                android:drawablePadding="12dp"
                android:drawableStart="@android:drawable/stat_notify_sync"
                android:gravity="center"
                android:onClick="OtaStart"
                android:paddingHorizontal="24dp"
                android:text="OTA Trigger"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:drawableTint="#FFFFFF" />
        </LinearLayout>

        <!-- Download Progress Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/fota_card_bg"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOWNLOAD FIRMWARE"
                android:textColor="#9EABB8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/progress_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="No file selected"
                android:textColor="#455A64"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select a file to begin"
                android:textColor="#90A4AE"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="12dp"
                android:progress="0"
                android:progressDrawable="@drawable/fota_progress_drawable" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#90A4AE"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/progressTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="0%"
                    android:textColor="@color/green"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="100%"
                    android:textColor="#90A4AE"
                    android:textSize="12sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Install Button -->
        <Button
            android:id="@+id/btn_install"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/fota_button_primary"
            android:drawablePadding="12dp"
            android:drawableStart="@drawable/electric_bolt_24px"
            android:gravity="center"
            android:onClick="StartUpdate"
            android:paddingHorizontal="32dp"
            android:text="Install Firmware"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:drawableTint="#FFFFFF" />

        <!-- Console Log Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/fota_card_bg"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="5dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text=">_ CONSOLE LOG"
                    android:textColor="#9EABB8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/copy_btn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/fota_icon_btn_bg"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_save"
                        app:tint="#78909C" />

                    <ImageButton
                        android:id="@+id/clear_btn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/fota_icon_btn_bg"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="#78909C" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Inner ScrollView — fixed height so it scrolls independently -->
            <ScrollView
                android:id="@+id/log_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="20dp"
                android:fadeScrollbars="false"
                android:scrollbars="vertical"
                android:nestedScrollingEnabled="true"
                android:isScrollContainer="true">

                <TextView
                    android:id="@+id/debug_logcat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/fota_log_bg"
                    android:fontFamily="monospace"
                    android:padding="16dp"
                    android:text="Console initialized..."
                    android:textColor="#37474F"
                    android:textSize="12sp" />

            </ScrollView>
        </LinearLayout>

        <!-- Hidden Buttons to maintain Java compatibility -->
        <Button
            android:id="@+id/download_btn"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <Button
            android:id="@+id/btn_integrity"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <Button
            android:id="@+id/btn_installcheck"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <View
            android:id="@+id/Et_downloaded_file"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>